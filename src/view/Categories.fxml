<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="385.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CategoriesController">
    <center>
        <HBox prefHeight="383.0" prefWidth="400.0" BorderPane.alignment="CENTER">
            <children>

                <VBox alignment="CENTER" prefHeight="383.0" prefWidth="220.0" spacing="10.0">
                    <children>

                        <Label text="Name" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <TextField fx:id="nameField" prefHeight="25.0" prefWidth="150.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddCategory" style="-fx-background-color: #3e89cb;" text="Add" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>

                                <Button fx:id="editButton" mnemonicParsing="false" onAction="#handleEditCategory" style="-fx-background-color: #3e89cb;" text="Edit" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <Label text="Search Category" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <TextField fx:id="searchField" promptText="Search Category" prefWidth="150.0" />

                        <Button mnemonicParsing="false" onAction="#handleSearchCategory" style="-fx-background-color: #3e89cb;" text="Search" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false"
                                onAction="#handleResetCategory"
                                text="Reset">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>

                        <Label text="Sort" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <ComboBox fx:id="sortComboBox" onAction="#handleSortCategory" prefWidth="150.0" promptText="Sort by" />

                    </children>

                    <HBox.margin>
                        <Insets left="80.0" right="80.0" />
                    </HBox.margin>
                </VBox>

                <TableView fx:id="categoryTable" prefHeight="386.0" prefWidth="300.0">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="100.0" text="ID" />
                        <TableColumn fx:id="nameColumn" minWidth="8.0" prefWidth="200.0" text="Name" />
                    </columns>
                    <HBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </HBox.margin>
                </TableView>

            </children>
        </HBox>
    </center>
</BorderPane>